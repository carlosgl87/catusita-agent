# Producto supervisores — supervisores humanos: jefes de línea y gerencia comercial.
# Autocontenido: su orquestador, sus áreas (cada una completa en su carpeta
# con prompt, subgrafo, tools, backend y tests) y su grafo.
# NO entra en esta imagen: vendedores/, clientes/
FROM python:3.13-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends     gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY plataforma/ ./plataforma/
COPY router/ ./router/
COPY supervisores/ ./supervisores/

CMD ["python", "-m", "plataforma.worker", "supervisores"]
