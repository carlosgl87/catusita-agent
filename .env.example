# Claude API
ANTHROPIC_API_KEY=sk-ant...

# Embeddings del RAG de procesos. Anthropic no ofrece embeddings, así que este
# es el ÚNICO uso de OpenAI en todo el sistema: el razonamiento sigue en Claude.
# Cambiar EMBEDDING_MODEL obliga a re-embeber todas las filas de conocimiento_*.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# Kapso (WhatsApp Cloud API oficial via Meta)
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/catusita_db

# Redis
REDIS_URL=redis://localhost:6379

# Mock SAP Server (en dev) / SAP real (en prod) — solo cambiar la URL
SAP_BASE_URL=https://mock-sap-catusita-production.up.railway.app
SAP_API_KEY=catusita-mock-key-2024

# Autenticación: usar usuarios mock en dev (sin base de datos)
USE_AUTH_MOCK=true
